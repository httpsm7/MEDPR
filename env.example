# MEDPR .env — Copy this to .env and fill in your keys
# chmod 600 .env  ← Always set this for security!

# ── AI Brain ──────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
GROK_API_KEY=

# ── News APIs ─────────────────────────────────────────────────────────
NEWSAPI_KEY=
GNEWS_KEY=

# ── Media APIs ────────────────────────────────────────────────────────
PEXELS_KEY=
REMOVEBG_KEY=

# ── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Text-to-Speech ────────────────────────────────────────────────────
ELEVENLABS_KEY=

# ── Instagram (Graph API) ─────────────────────────────────────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── X / Twitter (OAuth 1.0a) ──────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
